# -----------------------------------------------------------------------------
# Flash-sale platform — local configuration
#
# Every value below has a working default baked into docker-compose.yml, so
# `docker compose up -d` runs WITHOUT a .env file. Copy this file to `.env`
# only when you want to override something:   cp .env.example .env
#
# Full reference (what each variable does, prod values): docs/ENVIRONMENT.md
# -----------------------------------------------------------------------------

# --- Compose / host ports (bound to 127.0.0.1 except WEB_PORT) ---------------
COMPOSE_PROJECT_NAME=flashsale
WEB_PORT=8080                 # http://localhost:8080 -> NGINX (SPA + /api)
POSTGRES_HOST_PORT=55432      # psql -h localhost -p 55432 -U flash flashsale
REDIS_HOST_PORT=56379
RABBITMQ_HOST_PORT=55672
RABBITMQ_MGMT_HOST_PORT=15672 # http://localhost:15672 (user/pass below)
API_REPLICAS=3                # stateless API containers behind NGINX
WORKER_REPLICAS=2             # RabbitMQ consumers

# --- Infrastructure credentials (local only) ---------------------------------
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash
POSTGRES_DB=flashsale
RABBITMQ_USER=flash
RABBITMQ_PASSWORD=flash

# --- Application ---------------------------------------------------------------
APP_ENV=local                 # local | test | production
LOG_LEVEL=INFO
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRES_MINUTES=720
ADMIN_API_KEY=local-admin-key # header X-Admin-Key for /api/v1/admin/*
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173   # only needed for `npm run dev`
WEB_CONCURRENCY=1             # uvicorn processes per API container

# --- Rate limiting (app layer, Redis sliding window) --------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_CHECKOUT_PER_USER=5
RATE_LIMIT_CHECKOUT_PER_IP=200
RATE_LIMIT_AUTH_PER_IP=30

# --- Edge rate limiting (NGINX limit_req) -------------------------------------
NGINX_API_RATE=100r/s
NGINX_API_BURST=200
NGINX_CHECKOUT_RATE=20r/s
NGINX_CHECKOUT_BURST=40
NGINX_BOT_FILTER=1            # 1 = 403 on empty / scanner user-agents at checkout

# --- Worker -------------------------------------------------------------------
WORKER_PREFETCH=16            # set 1 for strictly sequential consumption
WORKER_MAX_RETRIES=5
WORKER_RETRY_DELAY_MS=2000

# --- Seed data (created by the one-shot `migrate` service) ---------------------
SEED_SALE_STOCK=500
SEED_SALE_STARTS_IN_SECONDS=120
SEED_SALE_DURATION_MINUTES=60

# --- Observability profile (docker compose --profile observability up -d) -----
PROMETHEUS_HOST_PORT=59090
GRAFANA_HOST_PORT=53000
GRAFANA_ADMIN_PASSWORD=admin
