{
  "ci": {
    "collect": {
      "url": ["http://localhost:8080/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "maxWaitForLoad": 15000
      }
    },
    "assert": {
      "assertions": {
        "interactive": ["error", { "maxNumericValue": 1500, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1500, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 204800 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1000, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
